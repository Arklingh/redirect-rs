# Local development (postgres from docker compose, port published on localhost)
DATABASE_URL=postgres://redirectrs:devpassword@localhost:5432/redirectrs
# URL the api uses to report clicks to the ingestion service
INGESTION_URL=http://localhost:3001
# Ingestion listen port (default 3001)
PORT=3001
# Optional: enables the redirect cache (api runs without it if unset or unreachable)
REDIS_URL=redis://localhost:6379
